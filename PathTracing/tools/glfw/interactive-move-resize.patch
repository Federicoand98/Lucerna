+GLFWAPI void glfwStartInteractiveMove(GLFWwindow* handle)
+{
+    _GLFW_REQUIRE_INIT();
+
+    _GLFWwindow* window = (_GLFWwindow*) handle;
+    assert(window != NULL);
+
+    _glfw.platform.startInteractiveMove(window);
+}
+
+GLFWAPI void glfwStartInteractiveResize(GLFWwindow* handle, int edges)
+{
+    _GLFW_REQUIRE_INIT();
+
+    _GLFWwindow* window = (_GLFWwindow*) handle;
+    assert(window != NULL);
+
+    if (edges <= 0 || edges > 15)
+        return;
+    _glfw.platform.startInteractiveResize(window, edges);
+}
