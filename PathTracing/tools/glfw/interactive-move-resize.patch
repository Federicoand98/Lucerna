+void _glfwStartInteractiveMoveWin32(_GLFWwindow* window)
+{
+    ReleaseCapture();
+    SendMessageW(window->win32.handle, WM_NCLBUTTONDOWN, HTCAPTION, 0);
+}
+
+void _glfwStartInteractiveResizeWin32(_GLFWwindow* window, int edges)
+{
+    WPARAM hit;
+    switch (edges)
+    {
+        case GLFW_WINDOW_EDGE_TOP: hit = HTTOP; break;
+        case GLFW_WINDOW_EDGE_BOTTOM: hit = HTBOTTOM; break;
+        case GLFW_WINDOW_EDGE_LEFT: hit = HTLEFT; break;
+        case GLFW_WINDOW_EDGE_RIGHT: hit = HTRIGHT; break;
+        case GLFW_WINDOW_EDGE_TOP | GLFW_WINDOW_EDGE_LEFT: hit = HTTOPLEFT; break;
+        case GLFW_WINDOW_EDGE_TOP | GLFW_WINDOW_EDGE_RIGHT: hit = HTTOPRIGHT; break;
+        case GLFW_WINDOW_EDGE_BOTTOM | GLFW_WINDOW_EDGE_LEFT: hit = HTBOTTOMLEFT; break;
+        case GLFW_WINDOW_EDGE_BOTTOM | GLFW_WINDOW_EDGE_RIGHT: hit = HTBOTTOMRIGHT; break;
+        default: return;
+    }
+    ReleaseCapture();
+    SendMessageW(window->win32.handle, WM_NCLBUTTONDOWN, hit, 0);
+}
